# Contact form email delivery (Resend — https://resend.com)
# Sign up, create an API key, and (for production) verify a sending domain.
RESEND_API_KEY=
# Address that receives contact-form submissions.
CONTACT_TO_EMAIL=
# Sender address. Until a domain is verified with Resend, use their sandbox
# sender (only deliverable to the account's own verified email address):
CONTACT_FROM_EMAIL=onboarding@resend.dev
